+      <h2
+        className={`mt-4 max-w-2xl font-display text-4xl font-semibold leading-[1.1] tracking-tight sm:text-5xl ${
+          invert ? "text-white" : "text-ink"
+        }`}
+      >
+        {t(title)}
+      </h2>
+    </div>
+  );
+}
